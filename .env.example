# Supabase (projeto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Apenas servidor — criar/editar usuários (Auth Admin). Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional — migrations locais (Project Settings → Database → password)
# SUPABASE_DB_PASSWORD=sua-senha-do-postgres
# Ou URI completa:
# DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres

# Google Places Autocomplete — use API KEY (comeca com AIza...), NAO OAuth Client ID
# Google Cloud → APIs & Services → Credentials → Create credentials → API key
# Habilitar: Maps JavaScript API + Places API
# Restricao recomendada: HTTP referrers → http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# N8N — extração da ficha técnica ao subir PDF de projeto (opcional)
# Webhook de entrada no N8N (Production URL do trigger)
N8N_WEBHOOK_FICHA_TECNICA_URL=https://seu-n8n.app/webhook/...
# Segredo compartilhado — o app envia no webhook; só precisa na Vercel (redeploy após alterar)
N8N_WEBHOOK_SECRET=gere-um-token-longo-aleatorio
# Supabase + OpenAI: configurar como CREDENCIAIS no n8n (ver n8n/README-ficha-tecnica.md)
# URL publica do app. Em Vercel pode omitir se VERCEL_URL existir.
# APP_BASE_URL=https://seu-app.vercel.app

# --- Planejado: Open route → ETA → SMS (n8n + Twilio) — ver docs/OPEN_ROUTE_ETA_SMS.md ---
# GOOGLE_MAPS_SERVER_API_KEY=AIzaSy...
# N8N_WEBHOOK_OPEN_ROUTE_URL=https://seu-n8n.app/webhook/...
