    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Normalizar payload').first().json;\nlet extracted = null;\ntry {\n  const t = $('Parse SHOWER FITTINGS').first().json;\n  if (t.parse_ok) extracted = t;\n} catch (e) { /* skip */ }\nif (!extracted) {\n  try {\n    const v = $('Parse resposta LLM').first().json;\n    if (v.parse_ok) extracted = v;\n  } catch (e) { /* skip */ }\n}\nif (!extracted) {\n  throw new Error('Dados da extracao nao encontrados');\n}\nconst items = extracted.items ?? [];\nconst mapped = items.map((item) => ({\n  ordem_servico_id: ctx.os_id,\n  os_ambiente_id: ctx.os_ambiente_id || null,\n  os_anexo_id: ctx.os_anexo_id,\n  section: item.section || 'SHOWER FITTINGS',\n  sku: item.sku,\n  quantity: item.quantity,\n  glass_spec: item.glass_spec,\n  finish: item.finish,\n  notes: item.notes ?? null,\n  sort_order: item.sort_order ?? 0,\n  catalogo_item_id: null,\n}));\n\nreturn [{ json: { ...ctx, ...extracted, insert_rows: mapped } }];"
      },
