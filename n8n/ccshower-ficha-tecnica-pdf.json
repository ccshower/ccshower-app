      "id": "a1000000-0000-4000-8000-000000000110",
      "name": "Supabase - Limpar itens antigos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, -200],
      "credentials": {
        "supabaseApi": {
          "name": "Supabase CCSHOWER"
        }
