      "id": "a1000000-0000-4000-8000-000000000096",
      "name": "OpenAI - Extrair SHOWER FITTINGS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, 120],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI CCSHOWER"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('PDF para base64').first().json;\nconst res = $input.first().json;\nlet text = '';\nif (res.choices?.[0]?.message?.content) {\n  text = String(res.choices[0].message.content);\n} else if (res.error?.message) {\n  return [{ json: { ...ctx, parse_ok: false, parse_error: res.error.message, items: [], item_count: 0, extraction_method: 'openai' } }];\n} else if (res.error) {\n  return [{ json: { ...ctx, parse_ok: false, parse_error: JSON.stringify(res.error), items: [], item_count: 0, extraction_method: 'openai' } }];\n}\n\nlet parsed = null;\ntry {\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : JSON.parse(text);\n} catch (e) {\n  return [{ json: { ...ctx, parse_ok: false, parse_error: 'OpenAI nao retornou JSON valido: ' + text.slice(0, 200), items: [], item_count: 0, extraction_method: 'openai' } }];\n}\n\nif (parsed?.error) {\n  return [{ json: { ...ctx, parse_ok: false, parse_error: parsed.error, items: [], item_count: 0, extraction_method: 'openai' } }];\n}\n\nconst items = (parsed?.items ?? []).map((item, i) => ({\n  section: item.section || 'SHOWER FITTINGS',\n  sku: String(item.sku || '').trim().toUpperCase(),\n  quantity: Number(item.quantity),\n  glass_spec: item.glass_spec?.trim() || null,\n  finish: item.finish?.trim() || null,\n  sort_order: typeof item.sort_order === 'number' ? item.sort_order : i,\n}));\n\nconst valid = items.filter((it) => it.sku && Number.isFinite(it.quantity) && it.quantity > 0);\nif (valid.length === 0) {\n  return [{ json: { ...ctx, parse_ok: false, parse_error: 'Nenhum item em SHOWER FITTINGS (OpenAI)', items: [], item_count: 0, extraction_method: 'openai' } }];\n}\n\nreturn [{ json: { ...ctx, parse_ok: true, parse_error: null, items: valid, item_count: valid.length, extraction_method: 'openai' } }];"
      },
