      "id": "a1000000-0000-4000-8000-000000000080",
      "name": "Extrair texto PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1440, -80]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Normalizar payload').first().json;\nconst pdfNode = $input.first().json;\nconst text = String(pdfNode.text ?? pdfNode.data ?? '');\n\nfunction parseShowerFittings(source) {\n  const normalized = source.replace(/\\r\\n/g, '\\n');\n  const start = normalized.search(/SHOWER\\s+FITTINGS/i);\n  if (start === -1) {\n    return { ok: false, error: 'Secao SHOWER FITTINGS nao encontrada no PDF' };\n  }\n\n  let chunk = normalized.slice(start);\n  const endMarkers = [/\\n\\s*HIGH\\s+DREAM/i, /\\n\\s*Page\\s+\\d+/i, /\\f/];\n  for (const marker of endMarkers) {\n    const idx = chunk.search(marker);\n    if (idx > 30) chunk = chunk.slice(0, idx);\n  }\n\n  const lines = chunk.split('\\n').slice(1);\n  const lineRe = /^\\s*(\\d+(?:\\.\\d+)?)\\s+([A-Z0-9][A-Z0-9-]*)\\s*(?:\\(([^)]+)\\))?\\s*(.*?)\\s*$/i;\n  const items = [];\n\n  for (const rawLine of lines) {\n    const line = rawLine.trim();\n    if (!line || /^SHOWER/i.test(line)) continue;\n    const match = line.match(lineRe);\n    if (!match) continue;\n    const [, qty, sku, glass, finishPart] = match;\n    items.push({\n      section: 'SHOWER FITTINGS',\n      sku: sku.toUpperCase(),\n      quantity: Number(qty),\n      glass_spec: glass?.trim() || null,\n      finish: finishPart?.trim() || null,\n      sort_order: items.length,\n    });\n  }\n\n  if (items.length === 0) {\n    return { ok: false, error: 'Nenhum item encontrado em SHOWER FITTINGS' };\n  }\n  return { ok: true, items };\n}\n\nconst parsed = parseShowerFittings(text);\n\nreturn [{\n  json: {\n    ...ctx,\n    parse_ok: parsed.ok,\n    parse_error: parsed.error ?? null,\n    items: parsed.items ?? [],\n    item_count: parsed.items?.length ?? 0,\n    extraction_method: 'text',\n  },\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000090",
      "name": "Parse SHOWER FITTINGS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, -80]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Normalizar payload').first().json;\nconst names = ['Download PDF (signed URL)', 'Download PDF (Supabase Storage)'];\nlet bin = null;\nlet fileName = ctx.nome_arquivo || 'drawing.pdf';\nfor (const n of names) {\n  try {\n    const row = $(n).first();\n    if (row.binary) {\n      const key = Object.keys(row.binary)[0];\n      bin = row.binary[key];\n      fileName = bin.fileName || fileName;\n      break;\n    }\n  } catch (e) { /* skip */ }\n}\nif (!bin?.data) {\n  return [{ json: { ...ctx, parse_ok: false, parse_error: 'Binario PDF nao encontrado para OpenAI', items: [], item_count: 0, extraction_method: 'openai' } }];\n}\n\nconst mime = bin.mimeType || 'application/pdf';\nconst rawB64 = String(bin.data);\nconst fileData = rawB64.startsWith('data:') ? rawB64 : `data:${mime};base64,${rawB64}`;\nconst model = (ctx.openai_model || 'gpt-4o').trim();\nconst prompt = [\n  'Voce recebe um INSTALLATION SHEET da CC Shower Door (PDF).',\n  'Extraia APENAS a secao SHOWER FITTINGS (lista de hardware).',\n  '',\n  'Retorne JSON com este formato:',\n  '{\"items\":[{\"section\":\"SHOWER FITTINGS\",\"sku\":\"CODIGO\",\"quantity\":1,\"glass_spec\":\"to suit 1/2\\\\\" glass ou null\",\"finish\":\"Brushed Bronze ou null\",\"sort_order\":0}]}',\n  '',\n  'Regras:',\n  '- sku em MAIUSCULAS',\n  '- quantity numerico',\n  '- glass_spec = texto entre parenteses apos o SKU',\n  '- finish = acabamento no fim da linha',\n  '- sort_order comeca em 0',\n  '- Se nao achar SHOWER FITTINGS: {\"items\":[],\"error\":\"motivo\"}',\n].join('\\n');\n\nreturn [{\n  json: {\n    ...ctx,\n    pdf_base64: rawB64,\n    pdf_mime: mime,\n    pdf_file_name: fileName,\n    openai_model: model,\n    openai_body: {\n      model,\n      temperature: 0,\n      max_tokens: 2048,\n      response_format: { type: 'json_object' },\n      messages: [{\n        role: 'user',\n        content: [\n          { type: 'file', file: { filename: fileName, file_data: fileData } },\n          { type: 'text', text: prompt },\n        ],\n      }],\n    },\n  },\n}];"
      },
