    {
      "parameters": {
        "jsCode": "const ctx = $('Montar rows Supabase').first().json;\nconst osList = $input.first().json;\nconst os = Array.isArray(osList) ? osList[0] : osList;\nconst equipe_id = os?.equipe_atual_id ?? os?.equipe_id ?? null;\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    ...ctx,\n    timeline_payload: equipe_id ? {\n      ordem_servico_id: ctx.os_id,\n      cliente_id: os.cliente_id,\n      equipe_id,\n      responsavel_id: null,\n      tipo_evento: 'cnc_ficha_importada',\n      etapa: 'project',\n      status: 'completed',\n      titulo: 'cnc_ficha_importada',\n      descricao: JSON.stringify({ os_anexo_id: ctx.os_anexo_id, item_count: ctx.item_count }),\n      data_inicio: now,\n      data_fim: now,\n    } : null,\n  },\n}];"
